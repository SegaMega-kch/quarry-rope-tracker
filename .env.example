DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-me"
# Keep true on the HTTPS server; false is only for a trusted local HTTP preview.
AUTH_COOKIE_SECURE="true"
SEED_SHIFT_1_PASSWORD="replace-me"
SEED_SHIFT_2_PASSWORD="replace-me"
SEED_SHIFT_3_PASSWORD="replace-me"
SEED_SHIFT_4_PASSWORD="replace-me"
SEED_BOSS_PASSWORD="replace-me"
SEED_STOREKEEPER_PASSWORD="replace-me"
SEED_ADMIN_PASSWORD="replace-me"

# Separate database for excavator production reports. Required in production.
# Use an absolute path outside the application's release/build directory.
# SHIFT_PRODUCTION_DATABASE_PATH="/var/lib/rapmas/shift-production.db"

# Read-only source for P/P statistics: the MAX report outbox database.
# Use an absolute path outside the application's release/build directory.
# PP_STATISTICS_DATABASE_PATH="/var/lib/rapmas/report-outbox.db"
