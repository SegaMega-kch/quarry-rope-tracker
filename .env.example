DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-me"
# Keep true on the HTTPS server; false is only for a trusted local HTTP preview.
AUTH_COOKIE_SECURE="true"
SEED_SHIFT_1_PASSWORD="replace-me"
SEED_SHIFT_2_PASSWORD="replace-me"
SEED_SHIFT_3_PASSWORD="replace-me"
SEED_SHIFT_4_PASSWORD="replace-me"
SEED_BOSS_PASSWORD="replace-me"
SEED_STOREKEEPER_PASSWORD="replace-me"
SEED_ADMIN_PASSWORD="replace-me"

# Separate database for excavator production reports. Required in production.
# Use an absolute path outside the application's release/build directory.
# SHIFT_PRODUCTION_DATABASE_PATH="/var/lib/rapmas/shift-production.db"

# Photo recognition pilot. "local" never sends images outside rapmas.
# "yandex" is an explicit opt-in; there is no automatic cloud fallback.
PRODUCTION_OCR_PROVIDER="local"
# Available to every authenticated account that can open «Отчёт за смену».
# The upload control is shown only on phones/tablets; the API rejects ordinary desktop requests.
# Writable absolute directory for the bundled Russian/English OCR models.
# PRODUCTION_OCR_MODEL_PATH="/var/lib/rapmas/ocr-models"
# Required only when PRODUCTION_OCR_PROVIDER="yandex". Never expose in NEXT_PUBLIC_*.
# YANDEX_OCR_API_KEY=""
# YANDEX_OCR_FOLDER_ID=""

# Existing private MAX bot/group configuration. It may point to the current report-worker JSON;
# the web app reads only tokenFile, botId, botUsername, chatId and chatTitle.
# SHIFT_PRODUCTION_MAX_CONFIG="/absolute/private/path/max-reports.json"

# Read-only source for P/P statistics: the MAX report outbox database.
# Use an absolute path outside the application's release/build directory.
# PP_STATISTICS_DATABASE_PATH="/var/lib/rapmas/report-outbox.db"
